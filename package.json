  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
